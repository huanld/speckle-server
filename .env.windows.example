# === Speckle Server - Windows Server Configuration ===

# --- External Services (running on Linux VPS) ---
POSTGRES_URL=YOUR_LINUX_VPS_IP
POSTGRES_USER=speckle
POSTGRES_PASSWORD=speckle
POSTGRES_DB=speckle

REDIS_URL=redis://YOUR_LINUX_VPS_IP:6379

S3_ENDPOINT=http://YOUR_LINUX_VPS_IP:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=speckle-server
S3_CREATE_BUCKET=true
S3_REGION=us-east-1

# --- Server Config ---
CANONICAL_URL=http://localhost
FRONTEND_ORIGIN=http://localhost
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
STRATEGY_LOCAL=true

LOG_LEVEL=info
LOG_PRETTY=true

# --- File Import ---
FILEIMPORT_QUEUE_POSTGRES_URL=postgresql://speckle:speckle@YOUR_LINUX_VPS_IP:5432/speckle
FF_NEXT_GEN_FILE_IMPORTER_ENABLED=true

# --- Binary Paths (Windows) ---
NODE_BINARY_PATH=C:\Program Files\nodejs\node.exe
PYTHON_BINARY_PATH=C:\Python313\python.exe
DOTNET_BINARY_PATH=C:\Program Files\dotnet\dotnet.exe

# --- Email (optional) ---
EMAIL=false
